{
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv add *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run alembic *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git mv *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(docker compose down *-v*)",
      "Bash(docker compose down *--volumes*)"
    ]
  }
}
